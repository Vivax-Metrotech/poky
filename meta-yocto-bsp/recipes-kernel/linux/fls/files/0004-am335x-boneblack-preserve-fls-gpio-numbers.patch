Upstream-Status: Inappropriate [FLS legacy userspace ABI on BeagleBone Black]

The installed FLS scripts and daemons address GPIOs as bank * 32 + line.
Keep that ABI on the Black independently of GPIO controller probe order.

--- a/drivers/gpio/gpio-omap.c
+++ b/drivers/gpio/gpio-omap.c
@@ -22,6 +22,7 @@
 #include <linux/pm_runtime.h>
 #include <linux/pm.h>
 #include <linux/of.h>
+#include <linux/of_address.h>
 #include <linux/gpio/driver.h>
 #include <linux/bitops.h>
 #include <linux/platform_data/gpio-omap.h>
@@ -1063,6 +1064,26 @@
 		bank->chip.label = label;
 	}
 	bank->chip.base = -1;
+	if (of_machine_is_compatible("ti,am335x-bone-black")) {
+		struct resource res;
+
+		if (!of_address_to_resource(bank->chip.parent->of_node, 0, &res)) {
+			switch (res.start) {
+			case 0x44e07000:
+				bank->chip.base = 0;
+				break;
+			case 0x4804c000:
+				bank->chip.base = 32;
+				break;
+			case 0x481ac000:
+				bank->chip.base = 64;
+				break;
+			case 0x481ae000:
+				bank->chip.base = 96;
+				break;
+			}
+		}
+	}
 	bank->chip.ngpio = bank->width;
 
 	irq = &bank->chip.irq;
