From: FLS Build Maintainers <build@vivax-metrotech.com>
Subject: [PATCH] linux-user: close truncated received rights and preserve CTRUNC

The host ancillary buffer can hold more SCM_RIGHTS descriptors than the target
buffer. Close descriptors not exposed to the guest, including complete trailing
messages and a failed guest buffer mapping. Otherwise recvmsg can leak host
descriptors even when the guest closes every descriptor it receives.

Set truncation in the host message flags: do_sendrecvmsg_locked copies those
flags over the guest message after conversion, losing guest-only updates.

Reproduced with ARM linux-user and Unix SOCK_SEQPACKET credentials/rights on a
64-bit host. A guest receiving 32 descriptors into a 16-descriptor buffer closes
all visible descriptors but leaks the omitted ones without this change.

Upstream-Status: Pending
---
diff --git a/linux-user/syscall.c b/linux-user/syscall.c
--- a/linux-user/syscall.c
+++ b/linux-user/syscall.c
@@ -1829,6 +1829,21 @@ static inline abi_long target_to_host_cmsg(struct msghdr *msgh,
     return 0;
 }
 
+static void close_remaining_cmsg_fds(struct msghdr *msgh, struct cmsghdr *cmsg)
+{
+    for (; cmsg; cmsg = CMSG_NXTHDR(msgh, cmsg)) {
+        if (cmsg->cmsg_level == SOL_SOCKET && cmsg->cmsg_type == SCM_RIGHTS) {
+            int *fds = (int *)CMSG_DATA(cmsg);
+            size_t count = (cmsg->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+            size_t i;
+
+            for (i = 0; i < count; i++) {
+                close(fds[i]);
+            }
+        }
+    }
+}
+
 static inline abi_long host_to_target_cmsg(struct target_msghdr *target_msgh,
                                            struct msghdr *msgh)
 {
@@ -1844,8 +1859,10 @@ static inline abi_long host_to_target_cmsg(struct target_msghdr *target_msgh,
     target_cmsg_addr = tswapal(target_msgh->msg_control);
     target_cmsg = lock_user(VERIFY_WRITE, target_cmsg_addr, msg_controllen, 0);
     target_cmsg_start = target_cmsg;
-    if (!target_cmsg)
+    if (!target_cmsg) {
+        close_remaining_cmsg_fds(msgh, cmsg);
         return -TARGET_EFAULT;
+    }
 
     while (cmsg && target_cmsg) {
         void *data = CMSG_DATA(cmsg);
@@ -1861,7 +1878,7 @@ static inline abi_long host_to_target_cmsg(struct target_msghdr *target_msgh,
          * in target_to_host_cmsg, which is a QEMU bug.
          */
         if (msg_controllen < sizeof(struct target_cmsghdr)) {
-            target_msgh->msg_flags |= tswap32(MSG_CTRUNC);
+            msgh->msg_flags |= MSG_CTRUNC;
             break;
         }
 
@@ -1891,7 +1908,7 @@ static inline abi_long host_to_target_cmsg(struct target_msghdr *target_msgh,
         }
 
         if (msg_controllen < TARGET_CMSG_LEN(tgt_len)) {
-            target_msgh->msg_flags |= tswap32(MSG_CTRUNC);
+            msgh->msg_flags |= MSG_CTRUNC;
             tgt_len = msg_controllen - sizeof(struct target_cmsghdr);
         }
 
@@ -1908,10 +1925,14 @@ static inline abi_long host_to_target_cmsg(struct target_msghdr *target_msgh,
                 int *fd = (int *)data;
                 int *target_fd = (int *)target_data;
                 int i, numfds = tgt_len / sizeof(int);
+                int allfds = len / sizeof(int);
 
                 for (i = 0; i < numfds; i++) {
                     __put_user(fd[i], target_fd + i);
                 }
+                for (; i < allfds; i++) {
+                    close(fd[i]);
+                }
                 break;
             }
             case SO_TIMESTAMP:
@@ -2057,6 +2078,10 @@ static inline abi_long host_to_target_cmsg(struct target_msghdr *target_msgh,
     }
     unlock_user(target_cmsg, target_cmsg_addr, space);
  the_end:
+    if (cmsg) {
+        msgh->msg_flags |= MSG_CTRUNC;
+        close_remaining_cmsg_fds(msgh, cmsg);
+    }
     target_msgh->msg_controllen = tswapal(space);
     return 0;
 }
